---
import { navItems } from "../data/personal";
import { en } from "../i18n/en";
import { th } from "../i18n/th";
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <nav class="container mx-auto px-6 py-5 flex items-center justify-between">
    <!-- Logo -->
    <a href="#home" class="flex items-center gap-2 group" aria-label="Home">
      <img
        src="/Tonedev.svg"
        alt="ToneDev Logo"
        class="logo-img"
        width="32"
        height="32"
      />
      <span
        class="font-display font-bold text-lg tracking-tight"
        style="color: var(--text)"
      >
        Tone<span class="gradient-text">dev</span>
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <ul class="hidden md:flex items-center gap-1 list-none">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link relative px-4 py-2 font-body font-medium text-sm transition-colors duration-200"
              style="color: var(--text-muted)"
              data-i18n={item.key}
            >
              {item.en}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right: Controls -->
    <div class="flex items-center gap-2">
      <!-- Language Toggle -->
      <button
        id="lang-toggle"
        aria-label="Switch to Thai"
        class="lang-toggle-btn w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110"
        style="background: var(--bg-2); border: 1px solid var(--border)"
      >
        <span
          class="lang-label font-mono text-xs font-bold"
          style="color: var(--blue)">TH</span
        >
      </button>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        aria-label="Toggle theme"
        class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 hover:scale-110"
        style="background: var(--bg-2); border: 1px solid var(--border)"
      >
        <!-- Sun (shown in dark mode) -->
        <svg
          id="icon-sun"
          class="w-5 h-5 block"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          style="color: var(--blue)"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <path
            d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
          ></path>
        </svg>
        <!-- Moon (shown in light mode) -->
        <svg
          id="icon-moon"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          style="color: var(--pink)"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Hire Me Button (desktop) -->
      <a href="#contact" class="btn-primary hidden md:inline-flex">
        <span data-i18n="nav.hireMe">Hire Me</span>
        <svg
          class="w-4 h-4 relative z-10"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5"
      >
        <span
          class="menu-line block w-6 h-0.5 transition-all duration-300"
          style="background: var(--text)"></span>
        <span
          class="menu-line block w-4 h-0.5 transition-all duration-300"
          style="background: var(--text)"></span>
        <span
          class="menu-line block w-6 h-0.5 transition-all duration-300"
          style="background: var(--text)"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden transition-all duration-400 ease-in-out"
    style="max-height: 0; background: var(--glass); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border)"
  >
    <ul class="container mx-auto px-6 py-4 flex flex-col gap-1 list-none">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="mobile-nav-link block py-3 px-4 rounded-lg font-body font-medium text-sm transition-all duration-200"
              style="color: var(--text-muted)"
              data-i18n={item.key}
            >
              {item.en}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a href="#contact" class="btn-primary w-full justify-center">
          <span data-i18n="nav.hireMe">Hire Me</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<!-- Inject all translations for client-side i18n -->
<script id="i18n-en" type="application/json" set:html={JSON.stringify(en)} />
<script id="i18n-th" type="application/json" set:html={JSON.stringify(th)} />

<style>
  @import "../styles/components/navbar.css";
</style>

<script>
  import "../scripts/navbar.ts";
  import "../scripts/i18n.ts";
</script>
