---
const projects = [
  {
    title: 'NexUI Dashboard',
    description: 'Comprehensive analytics dashboard with real-time data visualization, dark/light mode, and customizable widgets for enterprise teams.',
    tags: ['React', 'TypeScript', 'D3.js', 'TailwindCSS'],
    accent: 'blue',
    emoji: '📊',
    live: '#', repo: '#',
    featured: true,
  },
  {
    title: 'AstroShop',
    description: 'Full-stack e-commerce with Astro SSG, headless CMS integration, and edge-deployed serverless checkout flow.',
    tags: ['Astro', 'Node.js', 'PostgreSQL', 'Stripe'],
    accent: 'pink',
    emoji: '🛍️',
    live: '#', repo: '#',
    featured: false,
  },
  {
    title: 'DevSync API',
    description: 'High-performance REST/GraphQL API serving 100k+ req/day with JWT auth, rate limiting, and automated CI/CD pipelines.',
    tags: ['Fastify', 'GraphQL', 'Docker', 'Redis'],
    accent: 'mixed',
    emoji: '⚡',
    live: '#', repo: '#',
    featured: false,
  },
  {
    title: 'PortfolioAI',
    description: 'AI-powered portfolio generator creating personalized sites from resume data using GPT-4 and smart templates.',
    tags: ['Next.js', 'OpenAI', 'Vercel', 'Prisma'],
    accent: 'blue',
    emoji: '🤖',
    live: '#', repo: '#',
    featured: false,
  },
  {
    title: 'ToneChat',
    description: 'Real-time messaging app with E2E encryption, file sharing, and voice notes built with WebSocket and WebRTC.',
    tags: ['Vue.js', 'Socket.io', 'WebRTC', 'MongoDB'],
    accent: 'pink',
    emoji: '💬',
    live: '#', repo: '#',
    featured: false,
  },
  {
    title: 'CloudNotes',
    description: 'Minimalist markdown note-taking with offline support, cloud sync, and collaborative editing powered by CRDTs.',
    tags: ['React', 'IndexedDB', 'Yjs', 'Supabase'],
    accent: 'mixed',
    emoji: '📝',
    live: '#', repo: '#',
    featured: false,
  },
];
---

<section id="projects" class="section-pad relative overflow-hidden">

  <!-- Aurora -->
  <div class="aurora aurora-pink" style="width:420px;height:420px;top:-100px;right:-100px;opacity:0.16;"></div>
  <div class="aurora aurora-blue" style="width:320px;height:320px;bottom:-80px;left:5%;opacity:0.12;"></div>

  <!-- Ghost Number -->
  <span class="section-num" style="top:50%;right:-2%;transform:translateY(-50%);">03</span>

  <div class="container mx-auto relative z-10">

    <!-- ── Header ────────────────────────────────────── -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div>
        <p class="section-subtitle reveal">My Work</p>
        <h2 class="section-title reveal reveal-delay-1">
          Featured <span class="gradient-text">Projects</span>
        </h2>
      </div>
      <a href="#" class="reveal reveal-delay-2 btn-outline self-start md:self-auto whitespace-nowrap">
        All Projects →
      </a>
    </div>

    <!-- ── Grid ─────────────────────────────────────── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {projects.map((p, i) => (
        <article class={`reveal reveal-delay-${(i % 3) + 1} ui-card project-card group flex flex-col overflow-hidden`}>

          <!-- Visual header -->
          <div
            class="relative h-44 flex items-center justify-center overflow-hidden flex-shrink-0"
            style={p.accent === 'blue'
              ? 'background: linear-gradient(135deg, rgba(0,180,255,0.12) 0%, rgba(0,180,255,0.04) 100%)'
              : p.accent === 'pink'
                ? 'background: linear-gradient(135deg, rgba(255,26,110,0.12) 0%, rgba(255,26,110,0.04) 100%)'
                : 'background: linear-gradient(135deg, rgba(0,180,255,0.07) 0%, rgba(255,26,110,0.07) 100%)'}
          >
            <!-- Inner dot grid -->
            <div class="absolute inset-0 opacity-[0.07]"
                 style="background-image: radial-gradient(circle, var(--blue) 1px, transparent 1px); background-size: 20px 20px;"></div>

            <!-- Emoji -->
            <span class="text-5xl select-none transition-transform duration-300 group-hover:scale-110 relative z-10">
              {p.emoji}
            </span>

            <!-- Accent line top -->
            <div
              class="absolute top-0 left-0 right-0 h-[2px]"
              style={p.accent === 'blue'
                ? 'background: linear-gradient(90deg, transparent, var(--blue), transparent)'
                : p.accent === 'pink'
                  ? 'background: linear-gradient(90deg, transparent, var(--pink), transparent)'
                  : 'background: linear-gradient(90deg, transparent, var(--blue), var(--pink), transparent)'}
            ></div>

            <!-- Featured badge -->
            {p.featured && (
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full font-mono text-xs font-medium z-10"
                   style="background: linear-gradient(135deg, var(--blue), var(--pink)); color: white">
                ★ Featured
              </div>
            )}

            <!-- Hover overlay -->
            <div class="project-overlay absolute inset-0 flex items-center justify-center gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300"
                 style="background: rgba(7,7,14,0.88)">
              <a href={p.live} class="btn-primary" style="padding: 0.5rem 1.1rem; font-size: 0.8rem">
                <span>Live Demo</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                </svg>
              </a>
              <a href={p.repo} class="btn-outline" style="padding: 0.5rem 1.1rem; font-size: 0.8rem">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
                Code
              </a>
            </div>
          </div>

          <!-- Content -->
          <div class="flex flex-col flex-1 p-5 gap-3">
            <h3 class="font-display font-bold text-base transition-all duration-200 group-hover:gradient-text"
                style="color: var(--text)">
              {p.title}
            </h3>
            <p class="flex-1" style="font-size: 0.9rem; line-height: 1.75; color: var(--text-2)">
              {p.description}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1 border-t" style="border-color: var(--border)">
              {p.tags.map(tag => (
                <span class="skill-tag text-xs" style="padding: 0.25rem 0.65rem">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .project-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.4);
  }
  .project-card:hover h3 {
    background: linear-gradient(135deg, var(--blue), var(--pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
