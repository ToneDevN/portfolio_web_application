---
import { projects } from '../data/projects';

// Pass project data as JSON for interactive modal
const projectsJsonData = projects.map(p => ({
  id: p.id,
  titleKey: p.titleKey,
  descKey: p.descKey,
  category: p.category,
  categoryKey: p.categoryKey,
  tags: p.tags,
  accent: p.accent,
  emoji: p.emoji,
  live: p.live,
  repo: p.repo,
  featured: p.featured,
  metric: p.metric,
}));
---

<section id="projects" class="section-pad relative overflow-hidden">
  <!-- Ambient Auroras -->
  <div class="aurora aurora-pink" style="width:450px;height:450px;top:-120px;right:-100px;opacity:0.18;"></div>
  <div class="aurora aurora-blue" style="width:380px;height:380px;bottom:-100px;left:-50px;opacity:0.15;"></div>

  <!-- Section Ghost Number -->
  <span class="section-num" style="top:50%;right:-2%;transform:translateY(-50%);">03</span>

  <div class="container mx-auto relative z-10">

    <!-- ── Header ────────────────────────────────────── -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
      <div>
        <p class="section-subtitle reveal" data-i18n="projects.subtitle">My Work</p>
        <h2 class="section-title reveal reveal-delay-1">
          <span data-i18n="projects.title">Featured</span> <span class="gradient-text" data-i18n="projects.titleHighlight">Projects</span>
        </h2>
      </div>

      <!-- Filter Tabs -->
      <div class="prj-filters reveal reveal-delay-2" role="tablist">
        <button class="prj-filter is-active" data-filter="all" type="button">
          <span data-i18n="projects.filter.all">All Work</span>
        </button>
        <button class="prj-filter" data-filter="ai" type="button">
          <span data-i18n="projects.filter.ai">AI &amp; GraphRAG</span>
        </button>
        <button class="prj-filter" data-filter="fullstack" type="button">
          <span data-i18n="projects.filter.fullstack">Full-Stack</span>
        </button>
        <button class="prj-filter" data-filter="systems" type="button">
          <span data-i18n="projects.filter.systems">Systems &amp; Rust</span>
        </button>
      </div>
    </div>

    <!-- ── Bento Project Grid ───────────────────────────── -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projectsGrid">
      {projects.map((p, i) => {
        const isHero = p.featured && p.id === 'learner-support-system';
        return (
          <article 
            class={`reveal reveal-delay-${(i % 3) + 1} prj-card prj-card--${p.accent} group ${isHero ? 'md:col-span-2 lg:col-span-2' : ''}`}
            data-category={p.category}
            data-project-id={p.id}
          >
            <!-- Spotlight Overlay -->
            <div class="prj-card-spotlight" aria-hidden="true"></div>

            <!-- Top Header Visual -->
            <div class={`prj-visual ${isHero ? 'h-52' : 'h-40'} flex items-center justify-center relative overflow-hidden`}>
              <!-- Dot grid background -->
              <div class="absolute inset-0 opacity-[0.08]"
                   style="background-image: radial-gradient(circle, var(--blue) 1px, transparent 1px); background-size: 20px 20px;"></div>

              <!-- Animated Neon Border Line -->
              <div class="prj-line-beam"></div>

              <!-- Emoji Visual -->
              <span class={`prj-emoji select-none transition-transform duration-500 group-hover:scale-110 ${isHero ? 'text-6xl' : 'text-5xl'} relative z-10`}>
                {p.emoji}
              </span>

              <!-- Featured Pill -->
              {p.featured && (
                <div class="absolute top-3 left-3 px-3 py-1 rounded-full font-mono text-xs font-semibold z-10 prj-badge-featured" data-i18n="projects.featured">
                  ★ Featured
                </div>
              )}

              <!-- Metric Badge -->
              {p.metric && (
                <div class="absolute top-3 right-3 px-2.5 py-1 rounded-full font-mono text-[0.68rem] z-10 prj-badge-metric">
                  {p.metric}
                </div>
              )}
            </div>

            <!-- Content Area -->
            <div class="p-6 flex flex-col flex-1 justify-between gap-4 relative z-10">
              <div>
                <!-- Category Label -->
                <span class="prj-cat-label" data-i18n={p.categoryKey}>
                  {p.category}
                </span>

                <h3 class="font-display font-bold text-xl mt-1.5 transition-colors group-hover:gradient-text"
                    style="color: var(--text)"
                    data-i18n={p.titleKey}>
                  {p.titleKey}
                </h3>

                <p class="mt-2.5 text-sm leading-relaxed" style="color: var(--text-2)" data-i18n={p.descKey}>
                  {p.descKey}
                </p>
              </div>

              <!-- Tags & Action Footer -->
              <div class="pt-3 border-t flex flex-wrap items-center justify-between gap-3" style="border-color: var(--border)">
                <div class="flex flex-wrap gap-1.5">
                  {p.tags.map(tag => (
                    <span class="skill-tag text-xs" style="padding: 0.2rem 0.6rem">{tag}</span>
                  ))}
                </div>

                <div class="flex items-center gap-2">
                  <a href={p.live} target="_blank" rel="noopener" class="prj-btn prj-btn-demo" aria-label="Live Demo" title="Live Demo">
                    <span data-i18n="projects.liveDemo">Live Demo</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                  <a href={p.repo} target="_blank" rel="noopener" class="prj-btn prj-btn-code" aria-label="Source Code" title="Source Code">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- ── Project Detail Modal ──────────────────────────────── -->
<div class="prm-backdrop" id="projectModal" role="dialog" aria-modal="true" aria-label="Project Details">
  <div class="prm-panel">
    <button class="prm-close" id="projectModalClose" type="button" aria-label="Close modal">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <div class="flex items-center gap-3 mb-2">
      <span class="text-3xl" id="prmEmoji"></span>
      <div>
        <span class="prm-cat" id="prmCat"></span>
        <h3 class="prm-title" id="prmTitle"></h3>
      </div>
    </div>

    <div class="prm-metric-pill" id="prmMetric"></div>

    <p class="prm-desc" id="prmDesc"></p>

    <div class="mb-4">
      <h4 class="prm-section-title" data-i18n="projects.modal.techStack">Tech Stack</h4>
      <div class="prm-tags" id="prmTags"></div>
    </div>

    <div class="flex items-center gap-3 pt-4 border-t" style="border-color: var(--border)">
      <a href="#" id="prmLive" target="_blank" rel="noopener" class="btn-primary flex-1 text-center py-2.5">
        <span data-i18n="projects.liveDemo">Live Demo</span> →
      </a>
      <a href="#" id="prmRepo" target="_blank" rel="noopener" class="btn-outline flex-1 text-center py-2.5">
        <span data-i18n="projects.code">Source Code</span>
      </a>
    </div>
  </div>
</div>

<script id="projectsData" type="application/json" set:html={JSON.stringify(projectsJsonData)} />

<script>
  import "../scripts/projects.ts";
</script>

<style>
  @import '../styles/components/projects.css';
</style>
