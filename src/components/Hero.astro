---
const socials = [
  { label: "GitHub", href: "#", icon: "github" },
  { label: "LinkedIn", href: "#", icon: "linkedin" },
  { label: "Twitter", href: "#", icon: "twitter" },
  { label: "Email", href: "#", icon: "mail" },
];
---

<section
  id="home"
  class="relative min-h-screen flex items-center overflow-hidden noise"
>
  <!-- Aurora Background Orbs -->
  <div
    class="aurora aurora-blue animate-float-a"
    style="width:640px;height:640px;top:-180px;right:-80px;opacity:0.55;"
  >
  </div>
  <div
    class="aurora aurora-pink animate-float-b"
    style="width:480px;height:480px;bottom:-100px;left:-80px;opacity:0.4;"
  >
  </div>
  <div
    class="aurora aurora-blue animate-float-c"
    style="width:260px;height:260px;top:40%;left:30%;opacity:0.18;"
  >
  </div>

  <!-- Hero: two-column on lg+ -->
  <div class="container mx-auto px-6 relative z-10 pt-24 pb-12">
    <div class="flex items-center justify-between gap-8 xl:gap-16">
      <!-- ── Left: Text Content ───────────────────────── -->
      <div class="flex-1 min-w-0">
        <!-- Status badge -->
        <div class="reveal mb-6 flex items-center gap-3">
          <div class="flex gap-1.5">
            <span
              class="w-2 h-2 rounded-full animate-pulse-slow"
              style="background:var(--blue)"></span>
            <span
              class="w-2 h-2 rounded-full animate-pulse-slow"
              style="background:var(--pink);animation-delay:.5s"></span>
          </div>
          <span
            class="font-mono text-xs tracking-widest uppercase"
            style="color:var(--text-muted)">Available for work</span
          >
        </div>

        <!-- Heading -->
        <h1
          class="reveal reveal-delay-1 font-display leading-[1.1] mb-4"
          style="font-family:'Inter',sans-serif;font-weight:300;font-size:clamp(2.75rem,8vw,6rem);letter-spacing:-0.015em;color:var(--text)"
        >
          Hey, I'm<br />
          <span class="gradient-text" style="font-weight:400"
            >Nawamin Comjun</span
          >
        </h1>

        <!-- Typed role -->
        <div
          class="reveal reveal-delay-2 flex items-center gap-2 mb-6"
          style="font-size:clamp(1rem,2.5vw,1.35rem);font-family:'Inter',sans-serif;font-weight:300"
        >
          <span class="font-body" style="color:var(--text-muted)">— </span>
          <span
            id="typed-text"
            class="font-mono font-medium"
            style="color:var(--blue)"></span>
          <span class="cursor" aria-hidden="true"></span>
        </div>

        <!-- Description -->
        <p
          class="reveal reveal-delay-3 font-body mb-10"
          style="max-width:36rem;font-size:clamp(1rem,1.8vw,1.15rem);line-height:1.8;color:var(--text-2)"
        >
          I craft <strong style="color:var(--text);font-weight:500"
            >beautiful digital experiences</strong
          > that merge thoughtful design with clean, performant code. Let's build
          something extraordinary together.
        </p>

        <!-- CTA buttons -->
        <div class="reveal reveal-delay-4 flex flex-wrap gap-4 mb-12">
          <a href="#projects" class="btn-primary">
            <span>View My Work</span>
            <svg
              class="w-4 h-4 relative z-10"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
          <a href="#contact" class="btn-outline">
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
              ></path>
            </svg>
            Let's Talk
          </a>
        </div>

        <!-- Social links -->
        <div class="reveal reveal-delay-5 flex items-center gap-4">
          <span
            class="font-mono text-xs uppercase tracking-widest"
            style="color:var(--text-muted)">Find me →</span
          >
          {
            socials.map((s) => (
              <a href={s.href} aria-label={s.label} class="social-icon">
                {s.icon === "github" && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                )}
                {s.icon === "linkedin" && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
                {s.icon === "twitter" && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
                {s.icon === "mail" && (
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div><!-- /.left -->

      <!-- ── Right: 3D Globe ──────────────────────────── -->
      <div
        class="hero-canvas-wrap hidden lg:flex items-center justify-center
                  flex-shrink-0 reveal reveal-delay-3"
      >
        <canvas id="hero-3d" width="560" height="560"></canvas>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10"
  >
    <span
      class="font-mono text-xs uppercase tracking-widest"
      style="color:var(--text-muted)">scroll</span
    >
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  /* ── Canvas wrapper (responsive) ──────────────────── */
  .hero-canvas-wrap {
    width: clamp(360px, 36vw, 560px);
    height: clamp(360px, 36vw, 560px);
  }
  #hero-3d {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 0 48px rgba(0, 180, 255, 0.18));
  }
  html.light #hero-3d {
    filter: drop-shadow(0 0 48px rgba(0, 85, 204, 0.15));
  }

  /* ── Social icons ─────────────────────────────────── */
  .social-icon {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-2);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: all 0.25s ease;
  }
  .social-icon:hover {
    color: var(--blue);
    border-color: var(--blue);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 180, 255, 0.2);
  }

  /* ── Scroll indicator ─────────────────────────────── */
  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(180deg, var(--blue), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 1;
      transform: scaleY(1);
    }
    50% {
      opacity: 0.4;
      transform: scaleY(0.6);
    }
  }
</style>

<script>
  // ── Typing animation ──────────────────────────────────
  const roles = [
    "Full Stack Developer",
    "UI/UX Designer",
    "Creative Coder",
    "Problem Solver",
  ];
  const el = document.getElementById("typed-text")!;
  let roleIdx = 0,
    charIdx = 0,
    deleting = false;
  function type() {
    const cur = roles[roleIdx];
    el.textContent = deleting
      ? cur.slice(0, --charIdx)
      : cur.slice(0, ++charIdx);
    if (!deleting && charIdx === cur.length) {
      deleting = true;
      setTimeout(type, 2200);
      return;
    }
    if (deleting && charIdx === 0) {
      deleting = false;
      roleIdx = (roleIdx + 1) % roles.length;
    }
    setTimeout(type, deleting ? 42 : 88);
  }
  setTimeout(type, 800);

  // ── 3D Wireframe Globe with Skill Icon Orbiters ───────
  (() => {
    const canvas = document.getElementById(
      "hero-3d",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d")!;

    // Canvas is 560×560 (CSS scales it responsively)
    const S = 560,
      CX = 280,
      CY = 280,
      R = 115;
    const TAU = Math.PI * 2;

    // ── Wireframe geometry ─────────────────────────────
    const MERID = 10,
      PAR = 10,
      SEG = 64;
    type Pt3 = [number, number, number];

    const meridLines: Pt3[][] = [];
    for (let m = 0; m < MERID; m++) {
      const lng = (m / MERID) * TAU;
      const pts: Pt3[] = [];
      for (let s = 0; s <= SEG; s++) {
        const lat = (s / SEG) * Math.PI - Math.PI / 2;
        pts.push([
          Math.cos(lat) * Math.cos(lng),
          Math.sin(lat),
          Math.cos(lat) * Math.sin(lng),
        ]);
      }
      meridLines.push(pts);
    }

    const paraLines: Pt3[][] = [];
    for (let p = 1; p < PAR; p++) {
      const lat = (p / PAR) * Math.PI - Math.PI / 2;
      const yr = Math.sin(lat),
        cr = Math.cos(lat);
      const pts: Pt3[] = [];
      for (let s = 0; s <= SEG; s++) {
        const lng = (s / SEG) * TAU;
        pts.push([cr * Math.cos(lng), yr, cr * Math.sin(lng)]);
      }
      paraLines.push(pts);
    }
    const equatorIdx = PAR / 2 - 1; // p=5 → lat=0°

    // ── Skill definitions ──────────────────────────────
    // orbitIdx 0 = inner ring, 1 = outer ring
    // phase = fixed angular offset within the orbit
    interface SkillDef {
      slug: string;
      name: string;
      color: [number, number, number];
      orbitIdx: number;
      phase: number;
      img?: HTMLImageElement;
    }

    const skills: SkillDef[] = [
      // ── Inner orbit (6 skills, evenly spaced) ────────
      {
        slug: "react",
        name: "React",
        color: [97, 218, 251],
        orbitIdx: 0,
        phase: 0,
      },
      {
        slug: "typescript",
        name: "TypeScript",
        color: [49, 120, 198],
        orbitIdx: 0,
        phase: TAU / 6,
      },
      {
        slug: "nodedotjs",
        name: "Node.js",
        color: [83, 170, 83],
        orbitIdx: 0,
        phase: (TAU / 6) * 2,
      },
      {
        slug: "tailwindcss",
        name: "Tailwind",
        color: [6, 182, 212],
        orbitIdx: 0,
        phase: (TAU / 6) * 3,
      },
      {
        slug: "nextdotjs",
        name: "Next.js",
        color: [200, 200, 220],
        orbitIdx: 0,
        phase: (TAU / 6) * 4,
      },
      {
        slug: "python",
        name: "Python",
        color: [70, 130, 180],
        orbitIdx: 0,
        phase: (TAU / 6) * 5,
      },
      // ── Outer orbit (6 skills, offset by half-step) ──
      {
        slug: "docker",
        name: "Docker",
        color: [36, 150, 237],
        orbitIdx: 1,
        phase: TAU / 12,
      },
      {
        slug: "postgresql",
        name: "PostgreSQL",
        color: [65, 105, 225],
        orbitIdx: 1,
        phase: TAU / 12 + TAU / 6,
      },
      {
        slug: "mongodb",
        name: "MongoDB",
        color: [71, 162, 72],
        orbitIdx: 1,
        phase: TAU / 12 + (TAU / 6) * 2,
      },
      {
        slug: "figma",
        name: "Figma",
        color: [242, 78, 30],
        orbitIdx: 1,
        phase: TAU / 12 + (TAU / 6) * 3,
      },
      {
        slug: "github",
        name: "GitHub",
        color: [140, 140, 200],
        orbitIdx: 1,
        phase: TAU / 12 + (TAU / 6) * 4,
      },
      {
        slug: "vuedotjs",
        name: "Vue.js",
        color: [79, 192, 141],
        orbitIdx: 1,
        phase: TAU / 12 + (TAU / 6) * 5,
      },
    ];

    // Orbit ring parameters (rm = orbit radius as unit-sphere multiplier)
    const orbits = [
      { rm: 1.72, tilt: 0.3, spd: 0.0055, angle: 0 }, // inner — tilt ~17°
      { rm: 2.18, tilt: 0.9, spd: -0.0038, angle: 0 }, // outer — tilt ~52°, reverse
    ];

    // Preload white icons from Simple Icons CDN (CORS-enabled)
    for (const sk of skills) {
      const img = new Image();
      img.crossOrigin = "anonymous";
      img.onload = () => {
        sk.img = img;
      };
      img.src = `https://cdn.simpleicons.org/${sk.slug}/ffffff`;
    }

    // ── State ──────────────────────────────────────────
    let ry = 0;
    const rx = 0.28; // fixed pitch — equator stays visible
    let canvasMX = -9999,
      canvasMY = -9999; // mouse on canvas (for tooltip)

    // Tooltip: track mouse specifically on canvas
    canvas.addEventListener(
      "mousemove",
      (e: MouseEvent) => {
        const rc = canvas.getBoundingClientRect();
        canvasMX = (e.clientX - rc.left) * (S / rc.width);
        canvasMY = (e.clientY - rc.top) * (S / rc.height);
      },
      { passive: true },
    );
    canvas.addEventListener("mouseleave", () => {
      canvasMX = -9999;
      canvasMY = -9999;
    });

    // ── Helpers ────────────────────────────────────────
    function rot(
      px: number,
      py: number,
      pz: number,
      rxA: number,
      ryA: number,
    ): Pt3 {
      const cY = Math.cos(ryA),
        sY = Math.sin(ryA);
      const x = px * cY + pz * sY;
      const z0 = -px * sY + pz * cY;
      const cX = Math.cos(rxA),
        sX = Math.sin(rxA);
      const y = py * cX - z0 * sX;
      const z = py * sX + z0 * cX;
      return [x, y, z];
    }

    function lerpRGB(a: number[], b: number[], t: number) {
      return [
        a[0] + (b[0] - a[0]) * t,
        a[1] + (b[1] - a[1]) * t,
        a[2] + (b[2] - a[2]) * t,
      ];
    }

    function rgba(c: number[], a: number) {
      return `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${Math.min(1, a).toFixed(3)})`;
    }

    // ── Draw loop ──────────────────────────────────────
    type BadgeInfo = {
      sk: SkillDef;
      depth: number;
      sx: number;
      sy: number;
      badgeR: number;
    };

    function draw() {
      ctx.clearRect(0, 0, S, S);

      const isLight = document.documentElement.classList.contains("light");
      const BLU = isLight ? [0, 85, 204] : [0, 180, 255];
      const PNK = isLight ? [204, 0, 85] : [255, 26, 110];
      const BGa = isLight ? 0.05 : 0.07;

      // Advance angles each frame
      ry += 0.0035;
      for (const orb of orbits) orb.angle += orb.spd;

      const ryF = ry;
      const rxF = rx;

      // Outer ambient glow
      const grd = ctx.createRadialGradient(CX, CY, R * 0.5, CX, CY, R * 1.75);
      grd.addColorStop(0, rgba(BLU, BGa));
      grd.addColorStop(0.5, rgba(BLU, BGa * 0.3));
      grd.addColorStop(1, rgba(BLU, 0));
      ctx.fillStyle = grd;
      ctx.fillRect(0, 0, S, S);

      // ── Meridian lines ────────────────────────────────
      for (const pts of meridLines) {
        for (let i = 0; i < pts.length - 1; i++) {
          const [ax, ay, az] = rot(pts[i][0], pts[i][1], pts[i][2], rxF, ryF);
          const [bx, by, bz] = rot(
            pts[i + 1][0],
            pts[i + 1][1],
            pts[i + 1][2],
            rxF,
            ryF,
          );
          const depth = ((az + bz) * 0.5 + 1) * 0.5;
          ctx.beginPath();
          ctx.moveTo(CX + ax * R, CY - ay * R);
          ctx.lineTo(CX + bx * R, CY - by * R);
          ctx.strokeStyle = rgba(
            lerpRGB(BLU, PNK, depth * 0.35),
            0.05 + depth * 0.28,
          );
          ctx.lineWidth = 0.75;
          ctx.stroke();
        }
      }

      // ── Parallel lines ────────────────────────────────
      for (let pi = 0; pi < paraLines.length; pi++) {
        const pts = paraLines[pi];
        const isEq = pi === equatorIdx;
        for (let i = 0; i < pts.length - 1; i++) {
          const [ax, ay, az] = rot(pts[i][0], pts[i][1], pts[i][2], rxF, ryF);
          const [bx, by, bz] = rot(
            pts[i + 1][0],
            pts[i + 1][1],
            pts[i + 1][2],
            rxF,
            ryF,
          );
          const depth = ((az + bz) * 0.5 + 1) * 0.5;
          ctx.beginPath();
          ctx.moveTo(CX + ax * R, CY - ay * R);
          ctx.lineTo(CX + bx * R, CY - by * R);
          ctx.strokeStyle = rgba(
            lerpRGB(BLU, PNK, depth * 0.45),
            isEq ? 0.12 + depth * 0.52 : 0.04 + depth * 0.27,
          );
          ctx.lineWidth = isEq ? 1.4 : 0.75;
          ctx.stroke();
        }
      }

      // ── Grid intersection dots ────────────────────────
      for (let m = 0; m < MERID; m++) {
        const lng = (m / MERID) * TAU;
        for (let p = 1; p < PAR; p++) {
          const lat = (p / PAR) * Math.PI - Math.PI / 2;
          const ox = Math.cos(lat) * Math.cos(lng);
          const oy = Math.sin(lat);
          const oz = Math.cos(lat) * Math.sin(lng);
          const [rx3, ry3, rz3] = rot(ox, oy, oz, rxF, ryF);
          const depth = (rz3 + 1) * 0.5;
          if (depth < 0.08) continue;
          ctx.beginPath();
          ctx.arc(CX + rx3 * R, CY - ry3 * R, 1.1 + depth * 1.1, 0, TAU);
          ctx.fillStyle = rgba(
            lerpRGB(BLU, PNK, depth * 0.5),
            0.22 + depth * 0.58,
          );
          ctx.fill();
        }
      }

      // ── Pole accents ──────────────────────────────────
      for (const [px, py, pz] of [
        [0, 1, 0],
        [0, -1, 0],
      ] as Pt3[]) {
        const [rx3, ry3, rz3] = rot(px, py, pz, rxF, ryF);
        const depth = (rz3 + 1) * 0.5;
        if (depth < 0.1) continue;
        const sx = CX + rx3 * R,
          sy = CY - ry3 * R;
        const col = lerpRGB(BLU, PNK, depth);
        const glowG = ctx.createRadialGradient(sx, sy, 0, sx, sy, 18 * depth);
        glowG.addColorStop(0, rgba(col, 0.45 * depth));
        glowG.addColorStop(1, rgba(col, 0));
        ctx.fillStyle = glowG;
        ctx.beginPath();
        ctx.arc(sx, sy, 18 * depth, 0, TAU);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(sx, sy, 2.8 * depth, 0, TAU);
        ctx.fillStyle = rgba(col, 0.9);
        ctx.fill();
      }

      // ── Skill icon badges ─────────────────────────────
      // Compute world position + depth for each skill badge
      const badges: BadgeInfo[] = skills.map((sk) => {
        const orb = orbits[sk.orbitIdx];
        const a = orb.angle + sk.phase;
        const rm = orb.rm;
        // Point on tilted orbit plane (orbit radius rm in unit-sphere space)
        const ox = Math.cos(a) * rm;
        const oy = Math.sin(a) * Math.sin(orb.tilt) * rm;
        const oz = Math.sin(a) * Math.cos(orb.tilt) * rm;
        const [rx3, ry3, rz3] = rot(ox, oy, oz, rxF, ryF);
        const depth = (rz3 / rm + 1) * 0.5; // 0 = far back, 1 = front
        const badgeR = 20 + depth * 12; // 20px (back) → 32px (front)
        return { sk, depth, sx: CX + rx3 * R, sy: CY - ry3 * R, badgeR };
      });

      // Painter's algorithm: draw back badges first so front ones overlap correctly
      badges.sort((a, b) => a.depth - b.depth);

      // Find the topmost badge under the cursor (last match in sorted order = frontmost)
      let hovered: BadgeInfo | null = null;
      for (const b of badges) {
        const dx = canvasMX - b.sx,
          dy = canvasMY - b.sy;
        if (dx * dx + dy * dy < (b.badgeR + 4) ** 2) hovered = b;
      }

      for (const { sk, depth, sx, sy, badgeR } of badges) {
        if (depth < 0.06) continue; // skip badges facing fully away

        const alpha = 0.5 + depth * 0.5;
        const col = sk.color;

        // 1. Soft glow halo behind badge
        const glowR = badgeR * 2.5;
        const glowG = ctx.createRadialGradient(sx, sy, 0, sx, sy, glowR);
        glowG.addColorStop(0, rgba(col, 0.38 * depth));
        glowG.addColorStop(1, rgba(col, 0));
        ctx.fillStyle = glowG;
        ctx.beginPath();
        ctx.arc(sx, sy, glowR, 0, TAU);
        ctx.fill();

        // 2. Badge circle — always dark so white icon stays visible in both themes
        ctx.beginPath();
        ctx.arc(sx, sy, badgeR, 0, TAU);
        ctx.fillStyle = `rgba(10,10,22,${(0.78 + depth * 0.18).toFixed(3)})`;
        ctx.fill();
        // Coloured border ring
        ctx.strokeStyle = rgba(col, 0.72 * alpha);
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // 3. Icon image (white SVG from Simple Icons CDN)
        if (sk.img) {
          const iconSize = badgeR * 1.1;
          ctx.globalAlpha = alpha;
          ctx.drawImage(
            sk.img,
            sx - iconSize / 2,
            sy - iconSize / 2,
            iconSize,
            iconSize,
          );
          ctx.globalAlpha = 1;
        } else {
          // Fallback dot while image loads
          ctx.beginPath();
          ctx.arc(sx, sy, badgeR * 0.4, 0, TAU);
          ctx.fillStyle = rgba(col, alpha);
          ctx.fill();
        }
      }

      // ── Tooltip ───────────────────────────────────────
      if (hovered) {
        const { sk, sx, sy, badgeR } = hovered;
        ctx.font = '500 11px "JetBrains Mono", monospace';
        const tw = ctx.measureText(sk.name).width;
        const pw = tw + 18,
          ph = 22;
        let tx = sx - pw / 2;
        let ty = sy - badgeR - 10 - ph;
        if (ty < 4) ty = sy + badgeR + 10; // flip below if too close to top
        tx = Math.max(4, Math.min(S - pw - 4, tx));

        // Pill background
        ctx.fillStyle = "rgba(7,7,14,0.92)";
        ctx.beginPath();
        if (typeof (ctx as any).roundRect === "function") {
          (ctx as any).roundRect(tx, ty, pw, ph, 5);
        } else {
          ctx.rect(tx, ty, pw, ph);
        }
        ctx.fill();

        // Label text in the skill's brand colour
        ctx.fillStyle = rgba(sk.color, 1);
        ctx.textBaseline = "middle";
        ctx.textAlign = "left";
        ctx.fillText(sk.name, tx + 9, ty + ph / 2);
        ctx.textAlign = "start";
      }

      requestAnimationFrame(draw);
    }

    draw();
  })();
</script>
