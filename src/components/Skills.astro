---
import { skillGroups, skillStats } from "../data/skills";

// Build flat list for modal JSON — include i18n key refs so JS can translate
const allSkillsData = skillGroups.flatMap((g) =>
  g.skills.map((s) => ({
    name: s.name,
    slug: s.slug,
    level: s.level,
    since: s.since,
    descKey: s.descKey,
    tags: s.tagKeys,
    category: g.category,
    accent: g.accent,
    categoryKey: g.categoryKey,
  })),
);
---

<section id="skills" class="section-pad relative overflow-hidden">
  <!-- Dot grid texture -->
  <div class="sk-dots" aria-hidden="true"></div>

  <!-- Ambient glows -->
  <div class="sk-glow sk-glow--a" aria-hidden="true"></div>
  <div class="sk-glow sk-glow--b" aria-hidden="true"></div>

  <!-- Ghost watermark -->
  <span class="sk-ghost" aria-hidden="true">SKILLS</span>

  <!-- Section number -->
  <span
    class="section-num"
    style="top:50%;left:-1.5%;transform:translateY(-50%);">02</span
  >

  <div class="container mx-auto relative z-10">
    <!-- ── Header ───────────────────────────────────── -->
    <div class="sk-header reveal">
      <div class="sk-header-left">
        <p class="section-subtitle" data-i18n="skills.subtitle">
          What I Work With
        </p>
        <h2 class="section-title">
          <span data-i18n="skills.title">Skills &amp;</span>
          <span class="gradient-text" data-i18n="skills.titleHighlight"
            >Stack</span
          >
        </h2>
      </div>

      <div class="sk-stats">
        {
          skillStats.map((s) => (
            <div class="sk-stat">
              <span class="sk-stat-val gradient-text">{s.value}</span>
              <span class="sk-stat-label" data-i18n={s.labelKey}>
                {s.labelKey.split(".").pop()}
              </span>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ── Tabbed Container ──────────────────────────── -->
    <div class="sk-container reveal reveal-delay-1">
      <div class="sk-tabs-wrap">
        <div class="sk-tabs" role="tablist">
          {
            skillGroups.map((g, i) => (
              <button
                class={`sk-tab sk-tab--${g.accent}${i === 0 ? " is-active" : ""}`}
                data-tab={i}
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                type="button"
              >
                <span class="sk-tab-icon">{g.icon}</span>
                <span class="sk-tab-text" data-i18n={g.categoryKey}>
                  {g.category}
                </span>
                <span class="sk-tab-count">{g.skills.length}</span>
              </button>
            ))
          }
          <span class="sk-indicator" aria-hidden="true"></span>
        </div>
      </div>

      <!-- ── Skill Panels ──────────────────────────────── -->
      <div class="sk-panels">
        {
          skillGroups.map((g, gi) => (
            <div
              class={`sk-panel${gi === 0 ? " is-active" : ""}`}
              data-panel={gi}
              role="tabpanel"
            >
              <div class="sk-grid">
                {g.skills.map((skill, si) => (
                  <button
                    class={`sk-tile sk-tile--${g.accent}`}
                    style={`--i:${si}`}
                    data-skill={skill.name}
                    type="button"
                    aria-label={`View details for ${skill.name}`}
                  >
                    {skill.slug ? (
                      <img
                        src={`https://cdn.simpleicons.org/${skill.slug}/ffffff`}
                        data-src-dark={`https://cdn.simpleicons.org/${skill.slug}/ffffff`}
                        data-src-light={`https://cdn.simpleicons.org/${skill.slug}`}
                        class="sk-tile-icon"
                        width="28"
                        height="28"
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="sk-tile-fallback">{"</>"}</span>
                    )}
                    <span class="sk-tile-name">{skill.name}</span>
                    <span class="sk-tile-hint" data-i18n="skills.clickHint">
                      Click to explore
                    </span>
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div><!-- /sk-container -->
  </div>
</section>

<!-- ── Skill Modal ──────────────────────────────────────── -->
<div
  class="skm-backdrop"
  id="skillModal"
  role="dialog"
  aria-modal="true"
  aria-label="Skill details"
>
  <div class="skm-panel">
    <!-- Close -->
    <button
      class="skm-close"
      id="skillModalClose"
      type="button"
      aria-label="Close modal"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path
          d="M2 2l14 14M16 2L2 16"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- Header -->
    <div class="skm-head">
      <div class="skm-logo-wrap">
        <img
          class="skm-logo"
          id="skmLogo"
          src=""
          alt=""
          width="52"
          height="52"
        />
        <span class="skm-logo-fallback" id="skmLogoFallback"></span>
      </div>
      <div class="skm-head-info">
        <div class="skm-meta" id="skmMeta"></div>
        <h3 class="skm-name" id="skmName"></h3>
        <p class="skm-since" id="skmSince"></p>
      </div>
    </div>

    <!-- Proficiency bar -->
    <div class="skm-level-wrap">
      <div class="skm-level-header">
        <span class="skm-level-label" data-i18n="skills.modal.proficiency"
          >Proficiency</span
        >
        <span class="skm-level-value" id="skmLevelValue"></span>
      </div>
      <div class="skm-bar-track">
        <div class="skm-bar-fill" id="skmBarFill"></div>
      </div>
    </div>

    <!-- Description -->
    <p class="skm-desc" id="skmDesc"></p>

    <!-- Tags -->
    <div class="skm-tags-label" data-i18n="skills.modal.keyConcepts">
      Key Concepts
    </div>
    <div class="skm-tags" id="skmTags"></div>
  </div>
</div>

<!-- Inject skill data as JSON for JS -->
<script
  id="skillsData"
  type="application/json"
  set:html={JSON.stringify(allSkillsData)}
/>

<script>
  import "../scripts/skills.ts";
</script>

<style>
  @import "../styles/components/skills.css";
</style>
