---
import { navItems, socials, personal } from "../data/personal";
---

<footer class="relative overflow-hidden">
  <!-- Gradient Divider -->
  <div class="section-divider" style="opacity: 0.5"></div>

  <div class="container mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
      <!-- Brand -->
      <div>
        <a href="#home" class="inline-flex items-center gap-2 mb-4 group">
          <div class="relative w-8 h-8">
            <div
              class="absolute inset-0 rounded-lg"
              style="background: linear-gradient(135deg, var(--blue), var(--pink)); opacity: 0.85"
            >
            </div>
            <span
              class="relative z-10 flex items-center justify-center w-full h-full font-display font-bold text-white text-base leading-none"
              >T</span
            >
          </div>
          <span
            class="font-display font-bold text-base"
            style="color: var(--text)"
          >
            tone<span class="gradient-text">dev</span>
          </span>
        </a>
        <p
          class="text-sm leading-relaxed max-w-xs"
          style="color: var(--text-muted)"
          data-i18n="footer.tagline"
        >
          Crafting beautiful digital experiences at the intersection of design
          and engineering.
        </p>
      </div>

      <!-- Quick Nav -->
      <div>
        <h4
          class="font-mono text-xs uppercase tracking-widest mb-4"
          style="color: var(--text-muted)"
          data-i18n="footer.navigation"
        >
          Navigation
        </h4>
        <ul class="space-y-2 list-none">
          {
            navItems.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-nav-link text-sm transition-colors duration-200"
                  style="color: var(--text-muted)"
                  data-i18n={link.key}
                >
                  {link.en}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4
          class="font-mono text-xs uppercase tracking-widest mb-4"
          style="color: var(--text-muted)"
          data-i18n="footer.connect"
        >
          Let's Connect
        </h4>
        <a
          href={`mailto:${personal.email}`}
          class="footer-nav-link text-sm block mb-3"
          style="color: var(--text-muted)"
        >
          {personal.email}
        </a>
        <p class="text-sm mb-5" style="color: var(--text-muted)">
          {personal.location}
          {personal.locationEmoji}
        </p>

        <!-- Social Row -->
        <div class="flex gap-3">
          {
            socials.map((s) => (
              <a href={s.href} aria-label={s.label} class="footer-social">
                {s.icon === "github" && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                )}
                {s.icon === "linkedin" && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
                {s.icon === "twitter" && (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
                {s.icon === "mail" && (
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div
      class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4"
      style="border-top: 1px solid var(--border)"
    >
      <p class="font-mono text-xs" style="color: var(--text-muted)">
        © {new Date().getFullYear()}
        <span class="gradient-text font-medium">Nawamin Comjun</span>. <span
          data-i18n="footer.rights"></span>
      </p>
      <p
        class="font-mono text-xs"
        style="color: var(--text-muted)"
        data-i18n="footer.madeWith"
      >
        Made with ♥ using Astro
      </p>
    </div>
  </div>

  <!-- Back-to-top Button -->
  <button
    id="back-to-top"
    aria-label="Back to top"
    data-i18n-aria="footer.backToTop"
    class="fixed bottom-8 right-8 w-11 h-11 rounded-full flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:scale-110 z-40"
    style="background: linear-gradient(135deg, var(--blue), var(--pink)); box-shadow: 0 4px 20px rgba(0,180,255,0.35)"
  >
    <svg
      class="w-5 h-5 text-white"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      viewBox="0 0 24 24"
    >
      <path d="M18 15l-6-6-6 6"></path>
    </svg>
  </button>
</footer>

<style>
  @import "../styles/components/footer.css";
</style>

<script>
  import "../scripts/footer.ts";
</script>
