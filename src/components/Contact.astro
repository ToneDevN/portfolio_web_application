---
const contactInfo = [
  {
    label: 'Email',
    value: 'hello@yourname.dev',
    href: 'mailto:hello@yourname.dev',
    icon: 'mail',
  },
  {
    label: 'Location',
    value: 'Bangkok, Thailand',
    href: '#',
    icon: 'map',
  },
  {
    label: 'GitHub',
    value: '@yourhandle',
    href: 'https://github.com/yourhandle',
    icon: 'github',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/yourname',
    href: 'https://linkedin.com/in/yourname',
    icon: 'linkedin',
  },
];
---

<section id="contact" class="section-pad relative overflow-hidden">

  <!-- Aurora -->
  <div class="aurora aurora-pink" style="width:450px;height:450px;top:-120px;left:-100px;opacity:0.15;"></div>
  <div class="aurora aurora-blue" style="width:300px;height:300px;bottom:-80px;right:8%;opacity:0.12;"></div>

  <!-- Ghost Number -->
  <span class="section-num" style="top:50%;left:-2%;transform:translateY(-50%);">04</span>

  <div class="container mx-auto relative z-10">

    <!-- ── Header ────────────────────────────────────── -->
    <div class="text-center mb-14">
      <p class="section-subtitle reveal justify-center">Get In Touch</p>
      <h2 class="section-title reveal reveal-delay-1 mb-4">
        Let's <span class="gradient-text">Connect</span>
      </h2>
      <p class="reveal reveal-delay-2 max-w-lg mx-auto" style="font-size: 1.025rem; line-height: 1.75; color: var(--text-2)">
        Have a project in mind, or just want to say hi?
        My inbox is always open. I'll get back to you within 24 hours.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">

      <!-- ── Left: Contact Info ─────────────────────── -->
      <div class="lg:col-span-2 space-y-4">
        {contactInfo.map((info, i) => (
          <a
            href={info.href}
            target={info.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener noreferrer"
            class={`reveal reveal-delay-${i + 1} ui-card flex items-center gap-4 p-4 group contact-link`}
          >
            <!-- Icon -->
            <div
              class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 transition-all duration-250 group-hover:scale-110"
              style="background: rgba(0,180,255,0.08); border: 1px solid rgba(0,180,255,0.2)"
            >
              {info.icon === 'mail' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--blue)">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              )}
              {info.icon === 'map' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: var(--blue)">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              )}
              {info.icon === 'github' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" style="color: var(--blue)">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              )}
              {info.icon === 'linkedin' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" style="color: var(--blue)">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/>
                  <circle cx="4" cy="4" r="2"/>
                </svg>
              )}
            </div>

            <!-- Text -->
            <div>
              <p class="font-mono text-xs uppercase tracking-wide mb-0.5" style="color: var(--text-muted)">{info.label}</p>
              <p class="text-sm font-medium contact-value" style="color: var(--text)">{info.value}</p>
            </div>

            <!-- Arrow -->
            <svg
              class="w-4 h-4 ml-auto opacity-0 group-hover:opacity-100 transition-all duration-250 group-hover:translate-x-1"
              fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
              style="color: var(--blue)"
            >
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>

      <!-- ── Right: Contact Form ─────────────────────── -->
      <div class="lg:col-span-3 reveal reveal-delay-2">
        <form id="contact-form" class="ui-card p-8 space-y-5" novalidate>

          <!-- Row: Name + Email -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="form-group">
              <label class="font-mono text-xs uppercase tracking-wide" for="name" style="color: var(--text-muted)">Name *</label>
              <input type="text" id="name" name="name" placeholder="Your Name" class="input-field mt-1" required />
            </div>
            <div class="form-group">
              <label class="font-mono text-xs uppercase tracking-wide" for="email" style="color: var(--text-muted)">Email *</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" class="input-field mt-1" required />
            </div>
          </div>

          <!-- Subject -->
          <div class="form-group">
            <label class="font-mono text-xs uppercase tracking-wide" for="subject" style="color: var(--text-muted)">Subject</label>
            <input type="text" id="subject" name="subject" placeholder="Project Collaboration" class="input-field mt-1" />
          </div>

          <!-- Message -->
          <div class="form-group">
            <label class="font-mono text-xs uppercase tracking-wide" for="message" style="color: var(--text-muted)">Message *</label>
            <textarea id="message" name="message" placeholder="Tell me about your project..." rows="5" class="input-field mt-1 resize-none" required></textarea>
          </div>

          <!-- Submit -->
          <button type="submit" id="submit-btn" class="btn-primary w-full justify-center">
            <span id="btn-text">Send Message</span>
            <svg id="btn-icon" class="w-4 h-4 relative z-10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
            </svg>
          </button>

          <!-- Status -->
          <p id="form-status" class="font-mono text-xs text-center hidden"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .form-group { display: flex; flex-direction: column; }

  .contact-link:hover .contact-value {
    background: linear-gradient(135deg, var(--blue), var(--pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btnText = document.getElementById('btn-text')!;
  const status = document.getElementById('form-status')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btnText.textContent = 'Sending...';
    await new Promise((r) => setTimeout(r, 1500));
    btnText.textContent = '✓ Message Sent!';
    status.textContent = "Thanks! I'll reply within 24 hours.";
    status.style.color = 'var(--blue)';
    status.classList.remove('hidden');
    form.reset();
    setTimeout(() => {
      btnText.textContent = 'Send Message';
      status.classList.add('hidden');
    }, 5000);
  });
</script>
